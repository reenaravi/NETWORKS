Library Management System Using UDP

#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 5001

struct Book {
    int id;
    char title[50];
    int available;
};

struct Book books[] = {
    {101, "C_Programming", 1},
    {102, "Computer_Networks", 1},
    {103, "Operating_Systems", 1}
};

int main() {
    int sock, choice, id, i, found;
    char request[256], reply[512];
    struct sockaddr_in server, client;
    socklen_t len = sizeof(client);

    sock = socket(AF_INET, SOCK_DGRAM, 0);
    if (sock < 0) {
        perror("Socket");
        return 1;
    }

    memset(&server, 0, sizeof(server));
    server.sin_family = AF_INET;
    server.sin_addr.s_addr = INADDR_ANY;
    server.sin_port = htons(PORT);

    if (bind(sock, (struct sockaddr *)&server,
             sizeof(server)) < 0) {
        perror("Bind");
        close(sock);
        return 1;
    }

    printf("Library server running on port %d\n", PORT);

    while (1) {
        int n = recvfrom(sock, request, sizeof(request) - 1,
                         0, (struct sockaddr *)&client, &len);

        if (n < 0)
            continue;

        request[n] = '\0';

        if (sscanf(request, "%d %d", &choice, &id) < 1) {
            strcpy(reply, "Invalid request.");
        }
        else if (choice == 1) {
            strcpy(reply, "Available Books:\n");

            for (i = 0; i < 3; i++) {
                if (books[i].available) {
                    char line[100];

                    snprintf(line, sizeof(line),
                             "ID: %d, Title: %s\n",
                             books[i].id, books[i].title);

                    strncat(reply, line,
                            sizeof(reply) - strlen(reply) - 1);
                }
            }
        }
        else if (choice >= 2 && choice <= 4) {
            found = 0;

            for (i = 0; i < 3; i++) {
                if (books[i].id == id) {
                    found = 1;
                    break;
                }
            }

            if (!found) {
                strcpy(reply, "Book not found.");
            }
            else if (choice == 2) {
                snprintf(reply, sizeof(reply),
                         "Book found: %s", books[i].title);
            }
            else if (choice == 3) {
                if (books[i].available) {
                    books[i].available = 0;
                    strcpy(reply, "Book issued successfully.");
                } else {
                    strcpy(reply, "Book is already issued.");
                }
            }
            else {
                if (!books[i].available) {
                    books[i].available = 1;
                    strcpy(reply, "Book returned successfully.");
                } else {
                    strcpy(reply, "Book is already available.");
                }
            }
        }
        else {
            strcpy(reply, "Invalid choice.");
        }

        sendto(sock, reply, strlen(reply), 0,
               (struct sockaddr *)&client, len);

        printf("Request: %s\n", request);
    }

    close(sock);
    return 0;
}



#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <sys/select.h>

#define PORT 5001

int main() {
    int sock, choice, id, attempts, received;
    char request[256], reply[512];
    struct sockaddr_in server;
    socklen_t len = sizeof(server);

    sock = socket(AF_INET, SOCK_DGRAM, 0);
    if (sock < 0) {
        perror("Socket");
        return 1;
    }

    memset(&server, 0, sizeof(server));
    server.sin_family = AF_INET;
    server.sin_port = htons(PORT);
    inet_pton(AF_INET, "127.0.0.1", &server.sin_addr);

    while (1) {
        printf("\n1. View available books\n");
        printf("2. Search book by ID\n");
        printf("3. Issue book\n");
        printf("4. Return book\n");
        printf("5. Exit\nChoice: ");

        if (scanf("%d", &choice) != 1)
            break;

        if (choice == 5)
            break;

        id = 0;
        if (choice >= 2 && choice <= 4) {
            printf("Enter book ID: ");
            scanf("%d", &id);
        }

        snprintf(request, sizeof(request), "%d %d", choice, id);
        received = 0;

        for (attempts = 0; attempts < 3; attempts++) {
            sendto(sock, request, strlen(request), 0,
                   (struct sockaddr *)&server, len);

            fd_set readfds;
            FD_ZERO(&readfds);
            FD_SET(sock, &readfds);

            struct timeval timeout = {2, 0};

            if (select(sock + 1, &readfds, NULL, NULL,
                       &timeout) > 0) {
                int n = recvfrom(sock, reply, sizeof(reply) - 1,
                                 0, NULL, NULL);

                if (n >= 0) {
                    reply[n] = '\0';
                    received = 1;
                    break;
                }
            }

            printf("No acknowledgement. Retrying...\n");
        }

        if (received)
            printf("\nServer: %s\n", reply);
        else
            printf("Request failed after 3 attempts.\n");
    }

    close(sock);
    return 0;
}
