1466. Reorder Routes to Make All Paths Lead to the City Zero
#include <stdlib.h>

typedef struct {
    int to;
    int cost;
    int next;
} Edge;

int minReorder(int n, int** connections, int connectionsSize,
               int* connectionsColSize) {

    Edge* edges = malloc(2 * (n - 1) * sizeof(Edge));
    int* head = malloc(n * sizeof(int));
    int* visited = calloc(n, sizeof(int));

    for (int i = 0; i < n; i++)
        head[i] = -1;

    int edgeCount = 0;

    for (int i = 0; i < connectionsSize; i++) {
        int a = connections[i][0];
        int b = connections[i][1];

        // Original direction: a -> b
        // Cost 1 because it points away from city 0
        edges[edgeCount].to = b;
        edges[edgeCount].cost = 1;
        edges[edgeCount].next = head[a];
        head[a] = edgeCount++;

        // Reverse traversal: b -> a
        // Cost 0 because it points toward city 0
        edges[edgeCount].to = a;
        edges[edgeCount].cost = 0;
        edges[edgeCount].next = head[b];
        head[b] = edgeCount++;
    }

    // Iterative DFS to avoid recursion stack problems
    int* stack = malloc(n * sizeof(int));
    int top = 0;

    stack[top++] = 0;
    visited[0] = 1;

    int answer = 0;

    while (top > 0) {
        int node = stack[--top];

        for (int e = head[node]; e != -1; e = edges[e].next) {
            int next = edges[e].to;

            if (visited[next])
                continue;

            visited[next] = 1;

            answer += edges[e].cost;

            stack[top++] = next;
        }
    }

    free(edges);
    free(head);
    free(visited);
    free(stack);

    return answer;
}
