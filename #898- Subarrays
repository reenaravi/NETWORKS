898. Bitwise ORs of Subarrays

#include <stdlib.h>

#define HASH_SIZE 2000003

int hashFunc(int x) {
    return ((unsigned int)x * 2654435761u) % HASH_SIZE;
}

int subarrayBitwiseORs(int* arr, int arrSize) {
    int prev[32], curr[32];
    int prevSize = 0;
    int answer = 0;

    
    int* hash = calloc(HASH_SIZE, sizeof(int));
    char* used = calloc(HASH_SIZE, sizeof(char));

    for (int i = 0; i < arrSize; i++) {
        int currSize = 0;

        
        curr[currSize++] = arr[i];

      
        for (int j = 0; j < prevSize; j++) {
            int value = prev[j] | arr[i];

            
            if (value != curr[currSize - 1]) {
                curr[currSize++] = value;
            }
        }

        
        for (int j = 0; j < currSize; j++) {
            int value = curr[j];
            int h = hashFunc(value);

            while (used[h] && hash[h] != value) {
                h = (h + 1) % HASH_SIZE;
            }

            if (!used[h]) {
                used[h] = 1;
                hash[h] = value;
                answer++;
            }
        }

       
        for (int j = 0; j < currSize; j++) {
            prev[j] = curr[j];
        }

        prevSize = currSize;
    }

    free(hash);
    free(used);

    return answer;
}
