Online Railway Reservation System

// server.c 

#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 5001
#define TRAINS 3
#define BOOKINGS 100

struct Train {
    int id;
    char name[30];
    char route[50];
    int seats;
    float fare;
};

struct Booking {
    int pnr;
    int train_id;
    char passenger[50];
    int seats;
    int active;
};

struct Train trains[TRAINS] = {
    {101, "Chennai Express", "Chennai-Bangalore", 50, 250},
    {102, "Pandian Express", "Madurai-Chennai", 40, 350},
    {103, "Vaigai Express", "Madurai-Chennai", 30, 300}
};

struct Booking bookings[BOOKINGS];
int booking_count = 0;
int next_pnr = 1001;

void log_activity(const char *message) {
    FILE *fp = fopen("railway.log", "a");
    if (fp) {
        time_t now = time(NULL);
        fprintf(fp, "%s : %s\n", ctime(&now), message);
        fclose(fp);
    }
}

void process_request(int client, char request[]) {
    char response[4096] = "";
    int choice, id, seats, i, found = 0;
    char passenger[50];

    if (sscanf(request, "%d", &choice) != 1) {
        strcpy(response, "Invalid request.");
    }
    else if (choice == 1) {
        for (i = 0; i < TRAINS; i++) {
            char line[200];
            snprintf(line, sizeof(line),
                "Train ID: %d | Name: %s | Route: %s | "
                "Seats: %d | Fare: %.2f\n",
                trains[i].id, trains[i].name, trains[i].route,
                trains[i].seats, trains[i].fare);
            strncat(response, line,
                    sizeof(response) - strlen(response) - 1);
        }
    }
    else if (choice == 2) {
        if (sscanf(request, "%d %d", &choice, &id) != 2) {
            strcpy(response, "Enter a valid train ID.");
        } else {
            for (i = 0; i < TRAINS; i++) {
                if (trains[i].id == id) {
                    snprintf(response, sizeof(response),
                        "Train: %s\nRoute: %s\nAvailable seats: %d\n"
                        "Fare per seat: Rs. %.2f",
                        trains[i].name, trains[i].route,
                        trains[i].seats, trains[i].fare);
                    found = 1;
                    break;
                }
            }
            if (!found) strcpy(response, "Train not found.");
        }
    }
    else if (choice == 3) {
        if (sscanf(request, "%d %d %49s %d",
                   &choice, &id, passenger, &seats) != 4) {
            strcpy(response, "Invalid booking details.");
        } else {
            for (i = 0; i < TRAINS; i++)
                if (trains[i].id == id) {
                    found = 1;
                    break;
                }

            if (!found)
                strcpy(response, "Train not found.");
            else if (seats <= 0 || trains[i].seats < seats)
                strcpy(response, "Not enough seats available.");
            else if (booking_count >= BOOKINGS)
                strcpy(response, "Booking database is full.");
            else {
                trains[i].seats -= seats;
                bookings[booking_count].pnr = next_pnr++;
                bookings[booking_count].train_id = id;
                strcpy(bookings[booking_count].passenger, passenger);
                bookings[booking_count].seats = seats;
                bookings[booking_count].active = 1;

                snprintf(response, sizeof(response),
                    "Booking successful!\nPNR: %d\nPassenger: %s\n"
                    "Train ID: %d\nSeats: %d\nTotal fare: Rs. %.2f",
                    bookings[booking_count].pnr, passenger, id,
                    seats, trains[i].fare * seats);

                booking_count++;
                log_activity("Ticket booked");
            }
        }
    }
    else if (choice == 4) {
        if (sscanf(request, "%d %d", &choice, &id) != 2) {
            strcpy(response, "Enter a valid PNR.");
        } else {
            for (i = 0; i < booking_count; i++) {
                if (bookings[i].pnr == id && bookings[i].active) {
                    int j;
                    for (j = 0; j < TRAINS; j++)
                        if (trains[j].id == bookings[i].train_id) {
                            trains[j].seats += bookings[i].seats;
                            break;
                        }
                    bookings[i].active = 0;
                    strcpy(response, "Ticket cancelled successfully.");
                    log_activity("Ticket cancelled");
                    found = 1;
                    break;
                }
            }
            if (!found) strcpy(response, "Booking not found.");
        }
    }
    else if (choice == 5) {
        if (sscanf(request, "%d %d", &choice, &id) != 2) {
            strcpy(response, "Enter a valid PNR.");
        } else {
            for (i = 0; i < booking_count; i++) {
                if (bookings[i].pnr == id) {
                    snprintf(response, sizeof(response),
                        "PNR: %d\nPassenger: %s\nTrain ID: %d\n"
                        "Seats: %d\nStatus: %s",
                        bookings[i].pnr, bookings[i].passenger,
                        bookings[i].train_id, bookings[i].seats,
                        bookings[i].active ? "CONFIRMED" : "CANCELLED");
                    found = 1;
                    break;
                }
            }
            if (!found) strcpy(response, "Booking not found.");
        }
    }
    else {
        strcpy(response, "Invalid menu choice.");
    }

    send(client, response, strlen(response), 0);
    log_activity("Client request processed");
}

int main() {
    int server_fd, client_fd;
    struct sockaddr_in server, client;
    socklen_t len = sizeof(client);
    char request[1024];

    server_fd = socket(AF_INET, SOCK_STREAM, 0);
    if (server_fd < 0) {
        perror("Socket");
        return 1;
    }

    int opt = 1;
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    memset(&server, 0, sizeof(server));
    server.sin_family = AF_INET;
    server.sin_addr.s_addr = INADDR_ANY;
    server.sin_port = htons(PORT);

    if (bind(server_fd, (struct sockaddr *)&server,
             sizeof(server)) < 0 || listen(server_fd, 5) < 0) {
        perror("Server setup");
        close(server_fd);
        return 1;
    }

    printf("Railway server running on port %d\n", PORT);

    while (1) {
        client_fd = accept(server_fd, (struct sockaddr *)&client, &len);
        if (client_fd < 0) continue;

        memset(request, 0, sizeof(request));
        ssize_t n = recv(client_fd, request, sizeof(request) - 1, 0);
        if (n > 0) {
            request[n] = '\0';
            process_request(client_fd, request);
        }

        close(client_fd);
    }

    close(server_fd);
    return 0;
}



// client.c

#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 5001

int main() {
    int choice, train_id, seats, pnr;
    int sock;
    char passenger[50];
    char request[1024], response[4096];
    struct sockaddr_in server;
    ssize_t n;

    while (1) {
        printf("\n--- Online Railway Reservation ---\n");
        printf("1. View all trains\n");
        printf("2. Check seat availability\n");
        printf("3. Book ticket\n");
        printf("4. Cancel ticket\n");
        printf("5. View booking status\n");
        printf("6. Exit\n");
        printf("Enter choice: ");

        if (scanf("%d", &choice) != 1)
            break;

        if (choice == 6)
            break;

        if (choice == 1) {
            snprintf(request, sizeof(request), "1");
        }
        else if (choice == 2) {
            printf("Enter train ID: ");
            scanf("%d", &train_id);
            snprintf(request, sizeof(request), "2 %d", train_id);
        }
        else if (choice == 3) {
            printf("Enter train ID: ");
            scanf("%d", &train_id);
            printf("Enter passenger name (no spaces): ");
            scanf("%49s", passenger);
            printf("Enter number of seats: ");
            scanf("%d", &seats);

            snprintf(request, sizeof(request), "3 %d %s %d",
                     train_id, passenger, seats);
        }
        else if (choice == 4 || choice == 5) {
            printf("Enter PNR number: ");
            scanf("%d", &pnr);

            snprintf(request, sizeof(request), "%d %d",
                     choice, pnr);
        }
        else {
            printf("Invalid choice.\n");
            continue;
        }

        sock = socket(AF_INET, SOCK_STREAM, 0);
        if (sock < 0) {
            perror("Socket");
            continue;
        }

        memset(&server, 0, sizeof(server));
        server.sin_family = AF_INET;
        server.sin_port = htons(PORT);
        inet_pton(AF_INET, "127.0.0.1", &server.sin_addr);

        if (connect(sock, (struct sockaddr *)&server,
                    sizeof(server)) < 0) {
            perror("Connection failed");
            close(sock);
            continue;
        }

        if (send(sock, request, strlen(request), 0) < 0) {
            perror("Send failed");
            close(sock);
            continue;
        }

        shutdown(sock, SHUT_WR);

        n = recv(sock, response, sizeof(response) - 1, 0);
        if (n > 0) {
            response[n] = '\0';
            printf("\n%s\n", response);
        } else {
            printf("No response from server.\n");
        }

        close(sock);
    }

    return 0;
}


