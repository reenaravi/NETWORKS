#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define SIZE 1024

// Create server socket
void createServer(int *serverSocket)
{
    *serverSocket = socket(AF_INET, SOCK_STREAM, 0);

    if (*serverSocket < 0)
    {
        perror("Socket creation failed");
        exit(1);
    }

    printf("Server socket created\n");
}

// Bind server socket
void bindServer(int serverSocket, int port)
{
    struct sockaddr_in serverAddress;

    serverAddress.sin_family = AF_INET;
    serverAddress.sin_addr.s_addr = INADDR_ANY;
    serverAddress.sin_port = htons(port);

    if (bind(serverSocket,
             (struct sockaddr *)&serverAddress,
             sizeof(serverAddress)) < 0)
    {
        perror("Bind failed");
        exit(1);
    }

    printf("Server bind successful\n");
}

// Listen for client
void listenForClient(int serverSocket)
{
    if (listen(serverSocket, 5) < 0)
    {
        perror("Listen failed");
        exit(1);
    }

    printf("File server waiting for client...\n");
}

// Accept client
int acceptClient(int serverSocket,
                 struct sockaddr_in *clientAddress,
                 socklen_t *clientLength)
{
    int clientSocket;

    clientSocket = accept(serverSocket,
                          (struct sockaddr *)clientAddress,
                          clientLength);

    if (clientSocket < 0)
    {
        perror("Accept failed");
        return -1;
    }

    printf("Client connected\n");

    return clientSocket;
}

// Send all file data
void sendAll(int clientSocket, char *data, long size)
{
    long sent = 0;
    int bytes;

    while (sent < size)
    {
        bytes = send(clientSocket,
                     data + sent,
                     size - sent,
                     0);

        if (bytes <= 0)
            break;

        sent = sent + bytes;
    }
}

// Receive file name
void receiveFileName(int clientSocket, char *fileName)
{
    memset(fileName, 0, SIZE);

    recv(clientSocket,
         fileName,
         SIZE,
         0);
}

// Send file to client
void sendFile(int clientSocket)
{
    char fileName[SIZE];
    char buffer[SIZE];

    FILE *file;
    long fileSize;

    receiveFileName(clientSocket, fileName);

    printf("File requested: %s\n", fileName);

    file = fopen(fileName, "rb");

    if (file == NULL)
    {
        strcpy(buffer, "FILE_NOT_FOUND");

        send(clientSocket,
             buffer,
             strlen(buffer) + 1,
             0);

        printf("File not found\n");

        return;
    }

    strcpy(buffer, "FILE_FOUND");

    send(clientSocket,
         buffer,
         strlen(buffer) + 1,
         0);

    // Find file size
    fseek(file, 0, SEEK_END);

    fileSize = ftell(file);

    rewind(file);

    // Send file size
    send(clientSocket,
         &fileSize,
         sizeof(fileSize),
         0);

    // Send file contents
    while (!feof(file))
    {
        int bytesRead;

        bytesRead = fread(buffer,
                          1,
                          SIZE,
                          file);

        if (bytesRead > 0)
        {
            sendAll(clientSocket,
                    buffer,
                    bytesRead);
        }
    }

    fclose(file);

    printf("File sent successfully\n");
}

// Close client
void closeClient(int clientSocket)
{
    close(clientSocket);

    printf("Client disconnected\n");
}

// Run iterative file server
void runServer(int port)
{
    int serverSocket;
    int clientSocket;

    struct sockaddr_in clientAddress;
    socklen_t clientLength;

    clientLength = sizeof(clientAddress);

    createServer(&serverSocket);

    bindServer(serverSocket, port);

    listenForClient(serverSocket);

    while (1)
    {
        clientSocket = acceptClient(serverSocket,
                                    &clientAddress,
                                    &clientLength);

        if (clientSocket < 0)
            continue;

        sendFile(clientSocket);

        closeClient(clientSocket);
    }

    close(serverSocket);
}

int main(int argc, char *argv[])
{
    if (argc != 2)
    {
        printf("Usage: %s <port>\n", argv[0]);
        return 1;
    }

    runServer(atoi(argv[1]));

    return 0;
}


