#define _XOPEN_SOURCE 500  
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define SIZE 100
#define CMD_SIZE 256
#define MAX_ENTRIES 50

struct ARPEntry {
    char ip[30];
    char mac[30];
};

struct ARPEntry fallback_table[MAX_ENTRIES] = {
    {"192.168.1.1", "AA:BB:CC:DD:EE:01"},
    {"192.168.1.2", "AA:BB:CC:DD:EE:02"}
};
int entry_count = 2;

void createServer(int *serverSocket) {
    *serverSocket = socket(AF_INET, SOCK_STREAM, 0);
    if (*serverSocket < 0) {
        perror("Socket creation failed");
        exit(1);
    }
    printf("Server socket created\n");
}

void bindServer(int serverSocket, int port) {
    struct sockaddr_in serverAddress;
    serverAddress.sin_family = AF_INET;
    serverAddress.sin_addr.s_addr = INADDR_ANY;
    serverAddress.sin_port = htons(port);

    if (bind(serverSocket, (struct sockaddr *)&serverAddress, sizeof(serverAddress)) < 0) {
        perror("Bind failed");
        exit(1);
    }
    printf("Server bind successful\n");
}


int get_system_mac(const char *ip_address, char *output_mac) {
    char command[CMD_SIZE];
    char buffer[CMD_SIZE];
    FILE *fp;
    int found = 0;

    snprintf(command, sizeof(command), "ip neigh | grep %s 2>/dev/null", ip_address);
    
    
    fp = popen(command, "r");
    if (fp == NULL) return -1;

    while (fgets(buffer, sizeof(buffer), fp) != NULL) {
       
        char *lladdr_ptr = strstr(buffer, "lladdr");
        if (lladdr_ptr != NULL) {
            char *mac_ptr = lladdr_ptr + 7; 
            
           
            strncpy(output_mac, mac_ptr, 17);
            output_mac[17] = '\0';             
	    found = 1;
            break;
        }
    }
    pclose(fp);
    return found ? 0 : -1;
}

void searchIP(int clientSocket) {
    char ip[SIZE];
    char mac[SIZE];
    char message[SIZE];
    char retrieved_mac[SIZE];
    int i; 
    recv(clientSocket, ip, SIZE, 0);
    printf("Requested IP: %s\n", ip);

    if (get_system_mac(ip, retrieved_mac) == 0) {
        sprintf(message, "MAC Address: %s (From System)", retrieved_mac);
        send(clientSocket, message, strlen(message) + 1, 0);
        printf("IP found in system neighbor table\n");
        return;
    }

    for (i = 0; i < entry_count; i++) {
        if (strcmp(fallback_table[i].ip, ip) == 0) {
            sprintf(message, "MAC Address: %s (From Memory)", fallback_table[i].mac);
            send(clientSocket, message, strlen(message) + 1, 0);
            printf("IP found in local cache\n");
            return;
        }
    }

    printf("IP not found\n");
    strcpy(message, "IP not found. Enter MAC address:");
    send(clientSocket, message, strlen(message) + 1, 0);

    recv(clientSocket, mac, SIZE, 0);

    if (entry_count < MAX_ENTRIES) {
        strcpy(fallback_table[entry_count].ip, ip);
        strcpy(fallback_table[entry_count].mac, mac);
        entry_count++;
        strcpy(message, "New ARP entry added successfully to local memory");
        printf("New entry added locally\n");
    } else {
        strcpy(message, "Server cache full!");
    }

    send(clientSocket, message, strlen(message) + 1, 0);
}

void runServer(int port) {
    int serverSocket, clientSocket;
    struct sockaddr_in clientAddress;
    socklen_t clientLength = sizeof(clientAddress);

    createServer(&serverSocket);
    bindServer(serverSocket, port);
    listen(serverSocket, 5);
    printf("ARP Server waiting on port %d...\n", port);

    while (1) {
        clientSocket = accept(serverSocket, (struct sockaddr *)&clientAddress, &clientLength);
        if (clientSocket < 0) continue;

        searchIP(clientSocket);
        close(clientSocket);
    }
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        printf("Usage: %s <port>\n", argv[0]);
        return 1;
    }
    runServer(atoi(argv[1]));
}
