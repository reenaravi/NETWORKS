{
    twoDParity();
    return 0;
}

HAMMING CODE

#include <stdio.h>

int data[20], code[20], recv[20];
int n, r = 0;

void sender()
{
    int i, j, k = 0;
    r = 0;

    printf("\n====================================");
    printf("\n         HAMMING CODE");
    printf("\n====================================");

    printf("\nEnter number of data bits : ");
    scanf("%d", &n);

    printf("Enter %d Data Bits (with spaces) : ", n);
    for(i = 0; i < n; i++)
        scanf("%d", &data[i]);

    /* Calculating required redundancy bits */
    while((1 << r) < (n + r + 1))
        r++;

    printf("\nRedundancy bits required (r) = %d\n", r);
    printf("Total codeword length (n) = %d\n", n + r);

    /* Place data and parity bits placeholders (1-based from left) */
    for(i = 1; i <= n + r; i++)
    {
        if((i & (i - 1)) == 0)
            code[i] = 0; 
        else
        {
            code[i] = data[k];
            k++;
        }
    }

    /* Calculate parity bit values */
    for(i = 0; i < r; i++)
    {
        int p = 1 << i;
        int count = 0;

        for(j = 1; j <= n + r; j++)
        {
            if(j & p)
                count += code[j];
        }

        code[p] = count % 2;
    }

    printf("\nCodeword (position 1 to %d):\n", n + r);
    for(i = 1; i <= n + r; i++)
        printf("%d ", code[i]);

    printf("\n\nCodeword sent to channel (hamming.dat).\n");
}

void receiver()
{
    int i, j;
    int error = 0;
    int choice, position;

    printf("\nDo you want to flip a bit(1-yes, 0-no): ");
    scanf("%d", &choice);

    /* Copying original data to receiver array */
    for(i = 1; i <= n + r; i++)
        recv[i] = code[i];

    if(choice == 1)
    {
        printf("\nEnter bit position to flip (1 to %d): ", n + r);
        scanf("%d", &position);
        
        if(position >= 1 && position <= (n + r))
        {
            recv[position] = !recv[position];
        }
        else
        {
            printf("\nInvalid Position.\n");
            return;
        }
    }

    printf("\nReceived codeword (position 1 to %d):\n", n + r);
    for(i = 1; i <= n + r; i++)
        printf("%d ", recv[i]);
    printf("\n");

    /* Check parity syndrome */
    for(i = 0; i < r; i++)
    {
        int p = 1 << i;
        int count = 0;

        for(j = 1; j <= n + r; j++)
        {
            if(j & p)
                count += recv[j];
        }

        if(count % 2 != 0)
            error += p;
    }

    if(error == 0)
    {
        printf("\nNo error detected.\n");
    }
    else
    {
        printf("\nError detected at position %d.\n", error);

        /* Correcting the faulty bit */
        recv[error] = !recv[error];

        printf("\nReceived codeword (position 1 to %d):\n", n + r);
        for(i = 1; i <= n + r; i++)
            printf("%d ", recv[i]);
        printf("\nError corrected.\n");
    }

    printf("\nOriginal data bits: ");
    for(i = 1; i <= n + r; i++)
    {
        if((i & (i - 1)) != 0)
            printf("%d ", recv[i]);
    }
    printf("\n");
    printf("\nDo you want to flip another bit(1-yes, 0-no): 0\n");
}

int main()
{
    sender();
    receiver();
    return 0;
}






