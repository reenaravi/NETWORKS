Hotel Reservation System Using TCP

SERVER.C

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <pthread.h>
#include <time.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 5002
#define ROOMS 10

typedef struct {
    int room_no;
    int booked;
    char guest[50];
} Room;

Room rooms[ROOMS];
pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;

void log_event(const char *msg) {
    FILE *fp = fopen("hotel.log", "a");

    if (fp) {
        time_t now = time(NULL);
        fprintf(fp, "%s : %s\n", ctime(&now), msg);
        fclose(fp);
    }
}

void *handle_client(void *arg) {
    int client = *(int *)arg;
    free(arg);

    char request[512], response[2048];
    int choice, room_no, i, found;
    char guest[50];

    while (1) {
        memset(request, 0, sizeof(request));

        ssize_t n = recv(client, request,
                         sizeof(request) - 1, 0);

        if (n <= 0)
            break;

        request[n] = '\0';
        request[strcspn(request, "\r\n")] = '\0';
        response[0] = '\0';

        if (sscanf(request, "%d", &choice) != 1) {
            strcpy(response, "Invalid request.");
        }
        else if (choice == 1) {
            pthread_mutex_lock(&lock);

            for (i = 0; i < ROOMS; i++) {
                char line[100];

                snprintf(line, sizeof(line),
                    "Room %d: %s\n",
                    rooms[i].room_no,
                    rooms[i].booked ? "Booked" : "Available");

                strncat(response, line,
                    sizeof(response) - strlen(response) - 1);
            }

            pthread_mutex_unlock(&lock);
        }
        else if (choice == 2) {
            if (sscanf(request, "%d %d %49s",
                       &choice, &room_no, guest) != 3) {
                strcpy(response, "Invalid booking details.");
            } else {
                pthread_mutex_lock(&lock);
                found = 0;

                for (i = 0; i < ROOMS; i++) {
                    if (rooms[i].room_no == room_no) {
                        found = 1;
                        break;
                    }
                }

                if (!found) {
                    strcpy(response, "Room not found.");
                }
                else if (rooms[i].booked) {
                    strcpy(response, "Room is already booked.");
                }
                else {
                    rooms[i].booked = 1;
                    strcpy(rooms[i].guest, guest);
                    strcpy(response, "Room booked successfully.");
                    log_event("Room booked");
                }

                pthread_mutex_unlock(&lock);
            }
        }
        else if (choice == 3) {
            if (sscanf(request, "%d %d",
                       &choice, &room_no) != 2) {
                strcpy(response, "Invalid room number.");
            } else {
                pthread_mutex_lock(&lock);
                found = 0;

                for (i = 0; i < ROOMS; i++) {
                    if (rooms[i].room_no == room_no) {
                        found = 1;
                        break;
                    }
                }

                if (!found) {
                    strcpy(response, "Room not found.");
                }
                else if (!rooms[i].booked) {
                    strcpy(response, "Room is not booked.");
                }
                else {
                    rooms[i].booked = 0;
                    rooms[i].guest[0] = '\0';
                    strcpy(response, "Booking cancelled successfully.");
                    log_event("Room booking cancelled");
                }

                pthread_mutex_unlock(&lock);
            }
        }
        else if (choice == 4) {
            if (sscanf(request, "%d %d",
                       &choice, &room_no) != 2) {
                strcpy(response, "Invalid room number.");
            } else {
                pthread_mutex_lock(&lock);
                found = 0;

                for (i = 0; i < ROOMS; i++) {
                    if (rooms[i].room_no == room_no) {
                        found = 1;
                        break;
                    }
                }

                if (!found) {
                    strcpy(response, "Room not found.");
                }
                else if (rooms[i].booked) {
                    snprintf(response, sizeof(response),
                        "Room %d is booked by %s.",
                        room_no, rooms[i].guest);
                }
                else {
                    snprintf(response, sizeof(response),
                        "Room %d is available.", room_no);
                }

                pthread_mutex_unlock(&lock);
            }
        }
        else if (choice == 5) {
            strcpy(response, "Goodbye!");
            send(client, response, strlen(response), 0);
            break;
        }
        else {
            strcpy(response, "Invalid menu choice.");
        }

        if (send(client, response, strlen(response), 0) < 0)
            break;
    }

    close(client);
    return NULL;
}

int main() {
    int server_fd;
    struct sockaddr_in server;

    for (int i = 0; i < ROOMS; i++) {
        rooms[i].room_no = i + 1;
        rooms[i].booked = 0;
        rooms[i].guest[0] = '\0';
    }

    server_fd = socket(AF_INET, SOCK_STREAM, 0);
    if (server_fd < 0) {
        perror("Socket failed");
        return 1;
    }

    int opt = 1;
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR,
               &opt, sizeof(opt));

    memset(&server, 0, sizeof(server));
    server.sin_family = AF_INET;
    server.sin_addr.s_addr = INADDR_ANY;
    server.sin_port = htons(PORT);

    if (bind(server_fd, (struct sockaddr *)&server,
             sizeof(server)) < 0 ||
        listen(server_fd, 10) < 0) {
        perror("Server setup failed");
        close(server_fd);
        return 1;
    }

    printf("Hotel server running on port %d\n", PORT);

    while (1) {
        struct sockaddr_in client_addr;
        socklen_t len = sizeof(client_addr);

        int client = accept(server_fd,
            (struct sockaddr *)&client_addr, &len);

        if (client < 0)
            continue;

        int *p = malloc(sizeof(int));
        if (!p) {
            close(client);
            continue;
        }

        *p = client;
        pthread_t tid;

        if (pthread_create(&tid, NULL,
                           handle_client, p) != 0) {
            close(client);
            free(p);
            continue;
        }

        pthread_detach(tid);
    }

    close(server_fd);
    return 0;
}

CLIENT.C


#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 5002

int main() {
    int sock, choice, room_no;
    char guest[50];
    char request[512], response[2048];
    struct sockaddr_in server;
    ssize_t n;

    sock = socket(AF_INET, SOCK_STREAM, 0);

    if (sock < 0) {
        perror("Socket failed");
        return 1;
    }

    memset(&server, 0, sizeof(server));
    server.sin_family = AF_INET;
    server.sin_port = htons(PORT);
    inet_pton(AF_INET, "127.0.0.1", &server.sin_addr);

    if (connect(sock, (struct sockaddr *)&server,
                sizeof(server)) < 0) {
        perror("Connection failed");
        close(sock);
        return 1;
    }

    while (1) {
        printf("\n--- Hotel Reservation System ---\n");
        printf("1. View room availability\n");
        printf("2. Book a room\n");
        printf("3. Cancel booking\n");
        printf("4. View booking details\n");
        printf("5. Exit\n");
        printf("Enter choice: ");

        if (scanf("%d", &choice) != 1)
            break;

        if (choice == 1) {
            strcpy(request, "1");
        }
        else if (choice == 2) {
            printf("Enter room number: ");
            scanf("%d", &room_no);

            printf("Enter guest name (no spaces): ");
            scanf("%49s", guest);

            snprintf(request, sizeof(request),
                     "2 %d %s", room_no, guest);
        }
        else if (choice == 3 || choice == 4) {
            printf("Enter room number: ");
            scanf("%d", &room_no);

            snprintf(request, sizeof(request),
                     "%d %d", choice, room_no);
        }
        else if (choice == 5) {
            strcpy(request, "5");
        }
        else {
            printf("Invalid choice.\n");
            continue;
        }

        if (send(sock, request, strlen(request), 0) < 0) {
            perror("Send failed");
            break;
        }

        n = recv(sock, response, sizeof(response) - 1, 0);

        if (n <= 0) {
            printf("Server disconnected.\n");
            break;
        }

        response[n] = '\0';
        printf("\n%s\n", response);

        if (choice == 5)
            break;
    }

    close(sock);
    return 0;
}


