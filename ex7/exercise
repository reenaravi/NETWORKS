#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <sys/file.h>
#include <fcntl.h>
#include <signal.h>
#include <errno.h>

#define PORT 12345
#define TABLE_FILE "dns_table.txt"

#define MAX_DOMAIN 100
#define MAX_IP 50
#define BUFFER_SIZE 200

/* -------------------------------------------------- */
/* Remove zombie child processes                      */
/* -------------------------------------------------- */
void handle_sigchld(int sig)
{
    (void)sig;

    while (waitpid(-1, NULL, WNOHANG) > 0)
        ;
}

/* -------------------------------------------------- */
/* Create DNS table if it does not exist              */
/* -------------------------------------------------- */
void create_dns_table()
{
    FILE *fp;

    fp = fopen(TABLE_FILE, "r");

    if (fp != NULL)
    {
        fclose(fp);
        return;
    }

    fp = fopen(TABLE_FILE, "w");

    if (fp == NULL)
    {
        perror("Unable to create DNS table");
        exit(1);
    }

    fprintf(fp, "google.com 142.250.195.14\n");
    fprintf(fp, "youtube.com 142.250.72.14\n");
    fprintf(fp, "facebook.com 157.240.241.35\n");
    fprintf(fp, "instagram.com 157.240.241.174\n");
    fprintf(fp, "amazon.com 205.251.242.103\n");

    fclose(fp);
}

/* -------------------------------------------------- */
/* Search domain in DNS table                         */
/* -------------------------------------------------- */
/*
   Return:
       1 -> domain found
       0 -> domain not found

   IP is returned through ip[]
*/
int search_domain(const char *domain, char *ip)
{
    FILE *fp;
    int fd;

    char table_domain[MAX_DOMAIN];
    char table_ip[MAX_IP];

    fd = open(TABLE_FILE, O_RDONLY);

    if (fd < 0)
    {
        perror("open");
        return 0;
    }

    /* Shared lock for reading */
    flock(fd, LOCK_SH);

    fp = fdopen(fd, "r");

    if (fp == NULL)
    {
        close(fd);
        return 0;
    }

    while (fscanf(fp, "%99s %49s",
                  table_domain,
                  table_ip) == 2)
    {
        if (strcmp(domain, table_domain) == 0)
        {
            strcpy(ip, table_ip);

            flock(fd, LOCK_UN);
            fclose(fp);

            return 1;
        }
    }

    flock(fd, LOCK_UN);
    fclose(fp);

    return 0;
}

/* -------------------------------------------------- */
/* Add domain and IP to DNS table                    */
/* -------------------------------------------------- */
i0nt add_domain(const char *domain, const char *ip)
{
    FILE *fp;
    int fd;

    char table_domain[MAX_DOMAIN];
    char table_ip[MAX_IP];

    /*
     * Open for reading and writing.
     * O_APPEND ensures new entry is added at end.
     */
    fd = open(TABLE_FILE,
              O_RDWR | O_APPEND);

    if (fd < 0)
    {
        perror("open");
        return 0;
    }

    /*
     * Exclusive lock.
     * Only one child can modify the table at a time.
     */
    flock(fd, LOCK_EX);

    /*
     * Check again while holding the lock.
     *
     * This is important when two clients request
     * the same new domain simultaneously.
     */
    FILE *check_fp = fopen(TABLE_FILE, "r");

    if (check_fp != NULL)
    {
        while (fscanf(check_fp,
                      "%99s %49s",
                      table_domain,
                      table_ip) == 2)
        {
            if (strcmp(domain, table_domain) == 0)
            {
                fclose(check_fp);

                flock(fd, LOCK_UN);
                close(fd);

                return 2;
            }
        }

        fclose(check_fp);
    }

    /*
     * Move to end of file and write new entry.
     */
    fp = fdopen(fd, "a");

    if (fp == NULL)
    {
        flock(fd, LOCK_UN);
        close(fd);
        return 0;
    }

    fprintf(fp, "%s %s\n", domain, ip);
    fflush(fp);

    flock(fd, LOCK_UN);
    fclose(fp);

    return 1;
}

/* -------------------------------------------------- */
/* Print DNS table                                   */
/* -------------------------------------------------- */
void print_dns_table()
{
    FILE *fp;

    char domain[MAX_DOMAIN];
    char ip[MAX_IP];

    fp = fopen(TABLE_FILE, "r");

    if (fp == NULL)
    {
        perror("Unable to open DNS table");
        return;
    }

    printf("\n====================================================\n");
    printf("                 CURRENT DNS TABLE\n");
    printf("====================================================\n");

    printf("%-30s %-20s\n", "DOMAIN", "IP ADDRESS");

    printf("----------------------------------------------------\n");

    while (fscanf(fp, "%99s %49s", domain, ip) == 2)
    {
        printf("%-30s %-20s\n", domain, ip);
    }

    printf("====================================================\n");

    fclose(fp);
}

/* -------------------------------------------------- */
/* Main                                               */
/* -------------------------------------------------- */
int main()
{
    int server_sock;

    struct sockaddr_in server_addr;
    struct sockaddr_in client_addr;

    socklen_t client_len;

    char request[BUFFER_SIZE];

    signal(SIGCHLD, handle_sigchld);

    /*
     * Create DNS table
     */
    create_dns_table();

    /*
     * Create main UDP socket
     */
    server_sock = socket(AF_INET, SOCK_DGRAM, 0);

    if (server_sock < 0)
    {
        perror("Socket creation failed");
        exit(1);
    }

    /*
     * Allow port reuse
     */
    int opt = 1;

    setsockopt(server_sock,
               SOL_SOCKET,
               SO_REUSEADDR,
               &opt,
               sizeof(opt));

    memset(&server_addr, 0, sizeof(server_addr));

    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(PORT);

    /*
     * Bind server to port 8080
     */
    if (bind(server_sock,
             (struct sockaddr *)&server_addr,
             sizeof(server_addr)) < 0)
    {
        perror("Bind failed");
        close(server_sock);
        exit(1);
    }

    printf("\n====================================================\n");
    printf("             CONCURRENT DNS SERVER\n");
    printf("====================================================\n");

    printf("Protocol : UDP\n");
    printf("Port     : %d\n", PORT);

    printf("====================================================\n");

    print_dns_table();

    printf("\n====================================================\n");
    printf("          DNS SERVER READY\n");
    printf("Waiting for DNS requests...\n");
    printf("====================================================\n");

    /*
     * Main server loop
     */
    while (1)
    {
        memset(request, 0, sizeof(request));

        client_len = sizeof(client_addr);

        /*
         * Parent receives ONLY new DNS requests
         * on port 8080.
         */
        ssize_t n = recvfrom(server_sock,
                             request,
                             sizeof(request) - 1,
                             0,
                             (struct sockaddr *)&client_addr,
                             &client_len);

        if (n < 0)
        {
            if (errno == EINTR)
                continue;

            perror("recvfrom");
            continue;
        }

        request[n] = '\0';

        printf("\n[Parent] DNS Request Received\n");
        printf("Domain Requested : %s\n", request);

        /*
         * Create child for this request.
         */
        pid_t pid = fork();

        if (pid < 0)
        {
            perror("Fork failed");
            continue;
        }

        /*
         * ------------------------------------------------
         * CHILD PROCESS
         * ------------------------------------------------
         */
        if (pid == 0)
        {
            int child_sock;

            struct sockaddr_in child_addr;

            socklen_t child_len;

            char found_ip[MAX_IP];

            char response[BUFFER_SIZE];

            /*
             * Child does not need parent's listening socket.
             */
            close(server_sock);

            printf("\n[Child %d] Processing request\n",
                   getpid());

            printf("[Child %d] Domain : %s\n",
                   getpid(),
                   request);

            /*
             * Create a NEW UDP socket for this child.
             *
             * This is the important fix.
             */
            child_sock = socket(AF_INET,
                                SOCK_DGRAM,
                                0);

            if (child_sock < 0)
            {
                perror("Child socket creation failed");
                exit(1);
            }

            memset(&child_addr, 0, sizeof(child_addr));

            child_addr.sin_family = AF_INET;
            child_addr.sin_addr.s_addr = INADDR_ANY;
            child_addr.sin_port = htons(0);

            /*
             * Port 0 means the operating system chooses
             * a free temporary port.
             */
            if (bind(child_sock,
                     (struct sockaddr *)&child_addr,
                     sizeof(child_addr)) < 0)
            {
                perror("Child bind failed");
                close(child_sock);
                exit(1);
            }

            /*
             * Get the temporary port assigned to child.
             */
            child_len = sizeof(child_addr);

            getsockname(child_sock,
                        (struct sockaddr *)&child_addr,
                        &child_len);

            int child_port = ntohs(child_addr.sin_port);

            /*
             * Search DNS table.
             */
            memset(found_ip, 0, sizeof(found_ip));

            if (search_domain(request, found_ip))
            {
                /*
                 * DOMAIN FOUND
                 */
                printf("[Child %d] Domain found\n",
                       getpid());

                printf("[Child %d] IP : %s\n",
                       getpid(),
                       found_ip);

                snprintf(response,
                         sizeof(response),
                         "FOUND|%s",
                         found_ip);

                sendto(child_sock,
                       response,
                       strlen(response) + 1,
                       0,
                       (struct sockaddr *)&client_addr,
                       client_len);

                printf("[Child %d] Response sent\n",
                       getpid());

                close(child_sock);
                exit(0);
            }

            /*
             * DOMAIN NOT FOUND
             */
            printf("[Child %d] Domain not found\n",
                   getpid());

            printf("[Child %d] Waiting for IP from client\n",
                   getpid());

            /*
             * Tell client:
             *
             * Domain is not found.
             * Send the child port.
             */
            snprintf(response,
                     sizeof(response),
                     "NOTFOUND|%d",
                     child_port);

            sendto(child_sock,
                   response,
                   strlen(response) + 1,
                   0,
                   (struct sockaddr *)&client_addr,
                   client_len);

            /*
             * Now only this child socket waits
             * for the IP address.
             */
            char new_ip[MAX_IP];

            memset(new_ip, 0, sizeof(new_ip));

            ssize_t ip_len = recvfrom(child_sock,
                                      new_ip,
                                      sizeof(new_ip) - 1,
                                      0,
                                      (struct sockaddr *)&client_addr,
                                      &client_len);

            if (ip_len < 0)
            {
                perror("recvfrom IP");
                close(child_sock);
                exit(1);
            }

            new_ip[ip_len] = '\0';

            printf("[Child %d] IP received : %s\n",
                   getpid(),
                   new_ip);

            /*
             * Add to shared DNS table.
             */
            int result = add_domain(request, new_ip);

            if (result == 1)
            {
                printf("[Child %d] New DNS entry added\n",
                       getpid());

                printf("Domain : %s\n", request);
                printf("IP     : %s\n", new_ip);

                snprintf(response,
                         sizeof(response),
                         "ADDED|%s",
                         new_ip);
            }
            else if (result == 2)
            {
                /*
                 * Another concurrent child may have added
                 * the same domain first.
                 */
                char existing_ip[MAX_IP];

                memset(existing_ip, 0, sizeof(existing_ip));

                search_domain(request, existing_ip);

                printf("[Child %d] Domain was already added\n",
                       getpid());

                printf("Existing IP : %s\n",
                       existing_ip);

                snprintf(response,
                         sizeof(response),
                         "ADDED|%s",
                         existing_ip);
            }
            else
            {
                snprintf(response,
                         sizeof(response),
                         "ERROR|Unable to store entry");
            }

            /*
             * Send final response to client.
             */
            sendto(child_sock,
                   response,
                   strlen(response) + 1,
                   0,
                   (struct sockaddr *)&client_addr,
                   client_len);

            printf("[Child %d] Response sent\n",
                   getpid());

            close(child_sock);

            exit(0);
        }

        /*
         * ------------------------------------------------
         * PARENT PROCESS
         * ------------------------------------------------
         */

        printf("[Parent] Request assigned to Child PID %d\n",
               pid);
    }

    close(server_sock);

    return 0;
}
