#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <sys/select.h>
#include <errno.h>

#define PORT 9000
#define MAX_CLIENTS 20
#define BUFFER_SIZE 1024

typedef struct
{
    struct sockaddr_in address;
    int active;
} Client;

Client clients[MAX_CLIENTS];

int same_client(struct sockaddr_in *a,
                struct sockaddr_in *b)
{
    return a->sin_addr.s_addr == b->sin_addr.s_addr &&
           a->sin_port == b->sin_port;
}

int find_client(struct sockaddr_in *client)
{
   int i;
    for (i = 0; i < MAX_CLIENTS; i++)
    {
        if (clients[i].active &&
            same_client(&clients[i].address, client))
        {
            return i;
        }
    }

    return -1;
}

int add_client(struct sockaddr_in *client)
{
    int existing = find_client(client);

    if (existing != -1)
        return existing;
    int i;

    for (i = 0; i < MAX_CLIENTS; i++)
    {
        if (!clients[i].active)
        {
            clients[i].address = *client;
            clients[i].active = 1;

            printf("\n============================================\n");
            printf("Client %d connected\n", i + 1);
            printf("IP   : %s\n",
                   inet_ntoa(client->sin_addr));
            printf("Port : %d\n",
                   ntohs(client->sin_port));
            printf("============================================\n");

            return i;
        }
    }

    return -1;
}

void send_to_all(int sock,
                 char *message)
{
   int i;
    for (i = 0; i < MAX_CLIENTS; i++)
    {
        if (clients[i].active)
        {
            sendto(sock,
                   message,
                   strlen(message) + 1,
                   0,
                   (struct sockaddr *)&clients[i].address,
                   sizeof(clients[i].address));
        }
    }
}

int main()
{
    int sock;
    struct sockaddr_in server_addr;
    fd_set readfds;
    int i;

    for (i = 0; i < MAX_CLIENTS; i++)
        clients[i].active = 0;

    sock = socket(AF_INET, SOCK_DGRAM, 0);

    if (sock < 0)
    {
        perror("Socket creation failed");
        return 1;
    }

    int option = 1;

    setsockopt(sock,
               SOL_SOCKET,
               SO_REUSEADDR,
               &option,
               sizeof(option));

    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(PORT);

    if (bind(sock,
             (struct sockaddr *)&server_addr,
             sizeof(server_addr)) < 0)
    {
        perror("Bind failed");
        close(sock);
        return 1;
    }

    printf("\n============================================\n");
    printf("          UDP CHAT SERVER\n");
    printf("============================================\n");
    printf("Port : %d\n", PORT);
    printf("Waiting for clients...\n");
    printf("============================================\n");

    printf("Server > ");
    fflush(stdout);

    while (1)
    {
        FD_ZERO(&readfds);

        FD_SET(STDIN_FILENO, &readfds);
        FD_SET(sock, &readfds);

        int max_fd = sock;

        int activity = select(max_fd + 1,
                              &readfds,
                              NULL,
                              NULL,
                              NULL);

        if (activity < 0)
        {
            if (errno == EINTR)
                continue;

            perror("select");
            break;
        }

        /* =====================================
           UDP MESSAGE FROM CLIENT
           ===================================== */

        if (FD_ISSET(sock, &readfds))
        {
            char buffer[BUFFER_SIZE];

            struct sockaddr_in client_addr;
            socklen_t client_len =
                sizeof(client_addr);

            memset(buffer, 0, sizeof(buffer));

            int n = recvfrom(sock,
                             buffer,
                             sizeof(buffer) - 1,
                             0,
                             (struct sockaddr *)&client_addr,
                             &client_len);

            if (n < 0)
                continue;

            buffer[n] = '\0';

            int index = add_client(&client_addr);

            if (index == -1)
            {
                printf("\nMaximum clients reached.\n");
                printf("Server > ");
                fflush(stdout);
                continue;
            }

            if (strcmp(buffer, "exit") == 0)
            {
                printf("\n[Client %d disconnected]\n",
                       index + 1);

                clients[index].active = 0;

                printf("Server > ");
                fflush(stdout);
                continue;
            }

            printf("\nClient %d : %s\n",
                   index + 1,
                   buffer);

            printf("Server > ");
            fflush(stdout);
        }

        /* =====================================
           SERVER KEYBOARD
           ===================================== */

        if (FD_ISSET(STDIN_FILENO, &readfds))
        {
            char message[BUFFER_SIZE];

            if (fgets(message,
                      sizeof(message),
                      stdin) == NULL)
                continue;

            message[strcspn(message, "\n")] = '\0';

            if (strlen(message) == 0)
            {
                printf("Server > ");
                fflush(stdout);
                continue;
            }

            /* Stop server */
            if (strcmp(message, "/quit") == 0)
            {
                printf("\n[Server] Shutting down...\n");

                for (i = 0; i < MAX_CLIENTS; i++)
                {
                    if (clients[i].active)
                    {
                        sendto(sock,
                               "exit",
                               5,
                               0,
                               (struct sockaddr *)&clients[i].address,
                               sizeof(clients[i].address));
                    }
                }

                close(sock);
                break;
            }

            /* Broadcast */
            if (strncmp(message, "/all ", 5) == 0)
            {
                char *msg = message + 5;

                send_to_all(sock, msg);

                printf("Server -> All : %s\n",
                       msg);
            }
            else
            {
                /* Send to first active client */
                int sent = 0;

                for (i = 0; i < MAX_CLIENTS; i++)
                {
                    if (clients[i].active)
                    {
                        sendto(sock,
                               message,
                               strlen(message) + 1,
                               0,
                               (struct sockaddr *)&clients[i].address,
                               sizeof(clients[i].address));

                        printf("Server -> Client %d : %s\n",
                               i + 1,
                               message);

                        sent = 1;
                        break;
                    }
                }

                if (!sent)
                    printf("[Server] No clients connected.\n");
            }

            printf("Server > ");
            fflush(stdout);
        }
    }

    return 0;
}
