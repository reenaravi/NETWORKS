        perror("socket");
        return 1;
    }


    int opt = 1;

    setsockopt(sock,
               SOL_SOCKET,
               SO_REUSEADDR,
               &opt,
               sizeof(opt));


    memset(&server, 0, sizeof(server));

    server.sin_family =
        AF_INET;

    server.sin_addr.s_addr =
        INADDR_ANY;

    server.sin_port =
        htons(PORT);


    if (bind(sock,
             (struct sockaddr *)&server,
             sizeof(server)) < 0)
