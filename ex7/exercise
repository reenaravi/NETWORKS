#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <signal.h>

#define PORT 8080
#define MAX_SUBNETS 20

typedef struct
{
    uint32_t network;
    int prefix;
    int host_bits;
    uint32_t total;
    uint32_t usable;
    uint32_t next_host;
    uint32_t last_host;
    int required;
} Subnet;

typedef struct
{
    char name[100];
    int subnet_no;
} DHCPRequest;

typedef struct
{
    char name[100];
    int subnet_no;
    char ip[50];
    char mask[50];
    char gateway[50];
} DHCPResponse;


/* Convert IP address into 32-bit integer */
uint32_t ip_to_uint(int a, int b, int c, int d)
{
    return ((uint32_t)a << 24) |
           ((uint32_t)b << 16) |
           ((uint32_t)c << 8) |
           (uint32_t)d;
}


/* Convert 32-bit integer into IP address */
void uint_to_ip(uint32_t ip, char *s)
{
    sprintf(s, "%u.%u.%u.%u",
            (ip >> 24) & 255,
            (ip >> 16) & 255,
            (ip >> 8) & 255,
            ip & 255);
}


/* Create subnet mask from prefix */
uint32_t prefix_mask(int prefix)
{
    if (prefix == 0)
        return 0;

    return 0xFFFFFFFFu << (32 - prefix);
}


/* Convert subnet prefix to dotted decimal mask */
void mask_to_string(int prefix, char *s)
{
    uint32_t mask = prefix_mask(prefix);

    sprintf(s, "%u.%u.%u.%u",
            (mask >> 24) & 255,
            (mask >> 16) & 255,
            (mask >> 8) & 255,
            mask & 255);
}


/*
   Calculate number of host bits.

   50 hosts:
   2^5 - 2 = 30   -> not enough
   2^6 - 2 = 62   -> enough
   Therefore host bits = 6

   30 hosts:
   2^5 - 2 = 30
   Therefore host bits = 5

   10 hosts:
   2^4 - 2 = 14
   Therefore host bits = 4
*/
int required_host_bits(int hosts)
{
    int bits = 1;

    while (((1ULL << bits) - 2) < (unsigned long long)hosts)
    {
        bits++;
    }

    return bits;
}


int main()
{
