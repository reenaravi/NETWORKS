    printf("\n");
    printf("====================================================\n");
    printf("          CONCURRENT DHCP SERVER READY\n");
    printf("====================================================\n");

    printf("Port : %d\n",
           PORT);

    printf("Waiting for DHCP requests...\n");

    printf("====================================================\n");


    /* ---------------- DHCP REQUEST LOOP ---------------- */

    while (1)
    {
        DHCPRequest req;
        DHCPResponse res;


        memset(&req, 0, sizeof(req));
        memset(&res, 0, sizeof(res));


        client_len =
            sizeof(client);


        ssize_t bytes =
            recvfrom(sock,
                     &req,
                     sizeof(req),
                     0,
                     (struct sockaddr *)&client,
                     &client_len);


        if (bytes != sizeof(req))
        {
            printf("\nInvalid DHCP request received!\n");
            continue;
        }


        printf("\n");
        printf("[Server] DHCP Request Received\n");

        printf("Client Name      : %s\n",
               req.name);

        printf("Requested Subnet : %d\n",
               req.subnet_no);


        /* ---------------- INVALID SUBNET ---------------- */

        if (req.subnet_no < 1 ||
            req.subnet_no > n)
        {
            strcpy(res.name,
                   req.name);

            res.subnet_no =
                req.subnet_no;

            strcpy(res.ip,
                   "Invalid Subnet");


            sendto(sock,
                   &res,
                   sizeof(res),
                   0,
                   (struct sockaddr *)&client,
                   client_len);


            printf("[Server] Invalid subnet!\n");

            continue;
        }


        i =
            req.subnet_no - 1;


        /* ---------------- CHECK AVAILABLE IP ---------------- */

        if (sub[i].next_host >
            sub[i].last_host)
        {
            strcpy(res.name,
                   req.name);

            res.subnet_no =
                req.subnet_no;

            strcpy(res.ip,
                   "No IP Available");


            sendto(sock,
                   &res,
                   sizeof(res),
                   0,
                   (struct sockaddr *)&client,
                   client_len);


            printf("[Server] No IP available "
                   "in subnet %d!\n",
                   req.subnet_no);

            continue;
        }


        /*
           Allocate IP before fork.

           This guarantees unique allocation.
        */

        uint32_t assigned =
            sub[i].next_host++;


        uint_to_ip(assigned,
                   res.ip);


        strcpy(res.name,
               req.name);


        res.subnet_no =
            req.subnet_no;


        mask_to_string(sub[i].prefix,
                       res.mask);


        uint_to_ip(sub[i].network + 1,
                   res.gateway);


        /* ---------------- FORK ---------------- */

        pid_t pid =
            fork();


        if (pid < 0)
        {
            perror("fork");

            /*
               Return IP if fork fails.
            */

            sub[i].next_host--;

            continue;
        }


        if (pid == 0)
        {
            printf("\n");
            printf("[Child %d] Processing DHCP request\n",
                   getpid());

            printf("Client Name      : %s\n",
                   req.name);

            printf("Requested Subnet : %d\n",
                   req.subnet_no);

            printf("Assigned IP      : %s\n",
                   res.ip);

            printf("Subnet Mask      : %s\n",
                   res.mask);

            printf("Gateway          : %s\n",
                   res.gateway);


            sendto(sock,
                   &res,
                   sizeof(res),
                   0,
                   (struct sockaddr *)&client,
                   client_len);


            printf("[Child %d] DHCP response sent.\n",
                   getpid());


            close(sock);

            exit(0);
        }


        printf("[Parent] Client %s assigned to "
               "Child PID %d\n",
               req.name,
               pid);

        printf("[Parent] Reserved IP %s "
               "for Subnet %d\n",
               res.ip,
               req.subnet_no);
    }


    close(sock);

    return 0;
}
