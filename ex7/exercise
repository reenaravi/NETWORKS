    /*
     * Receive response.
     *
     * IMPORTANT:
     * response_addr tells us which child socket
    / * sent the response.
    memset(response, 0, sizeof(response));

    response_len = sizeof(response_addr);

    ssize_t n = recvfrom(sockfd,
                         response,
                         sizeof(response) - 1,
                         0,
                         (struct sockaddr *)&response_addr,
                         &response_len);
    if (n < 0)
    {
        perror("recvfrom");
        close(sockfd);
        return 1;
    }

    response[n] = '\0';

