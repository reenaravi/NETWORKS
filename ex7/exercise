    printf("\nEnter Base Address : ");

    if (scanf("%d.%d.%d.%d",
              &a, &b, &c, &d) != 4)
    {
        printf("Invalid IP address!\n");
        return 1;
    }


    if (a < 0 || a > 255 ||
        b < 0 || b > 255 ||
        c < 0 || c > 255 ||
        d < 0 || d > 255)
    {
        printf("Invalid IP address!\n");
        return 1;
    }


    printf("Enter Prefix : ");
    scanf("%d", &base_prefix);


    if (base_prefix < 0 || base_prefix > 30)
    {
        printf("Invalid prefix!\n");
        return 1;
    }


    printf("Enter Number of Subnets : ");
    scanf("%d", &n);


    if (n < 1 || n > MAX_SUBNETS)
    {
        printf("Invalid number of subnets!\n");
        return 1;
    }


    /* ---------------- BASE NETWORK ---------------- */

    uint32_t base_ip =
        ip_to_uint(a, b, c, d);

    uint32_t base_mask =
        prefix_mask(base_prefix);

    uint32_t base_network =
        base_ip & base_mask;

    uint64_t base_total =
        1ULL << (32 - base_prefix);


    /* ---------------- HOST REQUIREMENTS ---------------- */

    for (i = 0; i < n; i++)
    {
        printf("\nEnter Address Space Required for Subnet %d : ",
               i + 1);

        scanf("%d", &sub[i].required);


        if (sub[i].required < 1)
        {
            printf("Host requirement must be positive!\n");
            return 1;
        }
    }


    /* ---------------- VLSM CALCULATION ---------------- */

    uint64_t offset = 0;


    for (i = 0; i < n; i++)
    {
        /*
           Calculate host bits.
        */

        sub[i].host_bits =
            required_host_bits(sub[i].required);


        /*
           Prefix = 32 - host bits

           50 -> host bits 6 -> /26
           30 -> host bits 5 -> /27
           10 -> host bits 4 -> /28
        */

        sub[i].prefix =
            32 - sub[i].host_bits;


        /*
           Total addresses.
        */

        sub[i].total =
            (uint32_t)(1ULL << sub[i].host_bits);


        /*
           Usable addresses =
           Total - Network - Broadcast
        */

        sub[i].usable =
            sub[i].total - 2;


        /*
           Check whether subnet is larger
           than the base network.
        */

        if (sub[i].prefix < base_prefix)
        {
            printf("\nERROR: Subnet %d is too large!\n",
                   i + 1);

            return 1;
        }


        /*
           Calculate block size.
        */

        uint32_t block_size =
            sub[i].total;


        /*
           Current candidate address.
        */

        uint64_t candidate =
            (uint64_t)base_network + offset;


        /*
           Align subnet to proper boundary.
        */

        uint64_t remainder =
            candidate % block_size;


        if (remainder != 0)
        {
            candidate +=
                block_size - remainder;
        }


        /*
           Check whether subnet fits
           inside base network.
        */

        if ((candidate - base_network)
            + block_size > base_total)
        {
            printf("\nERROR: Requested subnets do not "
                   "fit inside the base network!\n");

            return 1;
        }


        sub[i].network =
            (uint32_t)candidate;


        /*
           Network address:
              network

           Gateway:
              network + 1

           DHCP starts:
              network + 2
        */

        sub[i].next_host =
            sub[i].network + 2;


        /*
           Broadcast = network + total - 1

           Last usable = broadcast - 1
                       = network + total - 2
        */

        sub[i].last_host =
            sub[i].network +
            sub[i].total - 2;


        /*
           Move to next subnet.
        */

        offset =
            (candidate - base_network)
            + block_size;
    }


