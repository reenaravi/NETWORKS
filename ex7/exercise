                     response,
                     sizeof(response) - 1,
                     0,
                     (struct sockaddr *)&response_addr,
                     &response_len);

        if (n < 0)
        {
            perror("recvfrom");
            close(sockfd);
            return 1;
        }

        response[n] = '\0';
        if (strncmp(response, "ADDED|", 6) == 0)
