hackerrank-min max riddle

#include <stdio.h>
#include <stdlib.h>

long* riddle(int arr_count, int* arr, int* result_count) {
    int n = arr_count;
    int *left = malloc(n * sizeof(int));
    int *right = malloc(n * sizeof(int));
    int *stack = malloc(n * sizeof(int));
    long *ans = malloc(n * sizeof(long));

    for (int i = 0; i < n; i++) {
        left[i] = -1;
        right[i] = n;
    }

    int top = -1;

    /* Previous smaller element */
    for (int i = 0; i < n; i++) {
        while (top >= 0 && arr[stack[top]] >= arr[i])
            top--;

        if (top >= 0)
            left[i] = stack[top];

        stack[++top] = i;
    }

    top = -1;

    /* Next smaller element */
    for (int i = n - 1; i >= 0; i--) {
        while (top >= 0 && arr[stack[top]] >= arr[i])
            top--;

        if (top >= 0)
            right[i] = stack[top];

        stack[++top] = i;
    }

    /* Find the window size for each element */
    for (int i = 0; i < n; i++) {
        int len = right[i] - left[i] - 1;

        if (ans[len - 1] < arr[i])
            ans[len - 1] = arr[i];
    }

    /* Fill missing window sizes */
    for (int i = n - 2; i >= 0; i--) {
        if (ans[i] < ans[i + 1])
            ans[i] = ans[i + 1];
    }

    *result_count = n;

    free(left);
    free(right);
    free(stack);

    return ans;
}

int main() {
    int n;
    scanf("%d", &n);

    int *arr = malloc(n * sizeof(int));

    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    int result_count;
    long *result = riddle(n, arr, &result_count);

    for (int i = 0; i < result_count; i++) {
        if (i > 0)
            printf(" ");
        printf("%ld", result[i]);
    }

    printf("\n");

    free(arr);
    free(result);

    return 0;
}
