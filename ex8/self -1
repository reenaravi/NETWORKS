Go-Back-N Sliding Window Protocol

#include <stdio.h>

int main() {
    int n, window, lost, i;
    int transmissions = 0;
    int retransmissions = 0;

    printf("Enter number of frames: ");
    scanf("%d", &n);

    printf("Enter window size: ");
    scanf("%d", &window);

    if (n <= 0 || window <= 0) {
        printf("Invalid input.\n");
        return 1;
    }

    printf("Enter frame number to simulate loss (0 for none): ");
    scanf("%d", &lost);

    if (lost < 0 || lost > n) {
        printf("Invalid frame number.\n");
        return 1;
    }

    i = 1;

    while (i <= n) {
        int end = i + window - 1;
        if (end > n)
            end = n;

        printf("\nSending frames %d to %d\n", i, end);

        for (int j = i; j <= end; j++) {
            printf("Frame %d sent.\n", j);
            transmissions++;
        }

        if (lost >= i && lost <= end) {
            printf("Frame %d lost! Timeout occurred.\n", lost);
            printf("Receiver discards subsequent out-of-order frames.\n");

            printf("Go-Back-N retransmits frames %d to %d\n",
                   lost, end);

            for (int j = lost; j <= end; j++) {
                printf("Frame %d retransmitted and acknowledged.\n", j);
                transmissions++;
                retransmissions++;
            }

            lost = 0;
            i = end + 1;
        } else {
            printf("All frames acknowledged.\n");
            i = end + 1;
        }
    }

    printf("\nTotal transmissions: %d\n", transmissions);
    printf("Retransmissions: %d\n", retransmissions);
    printf("Successful frames: %d\n", n);

    return 0;
}
