
#include <stdlib.h>

int* maxSlidingWindow(int* nums, int numsSize,
                      int k, int* returnSize) {
    *returnSize = 0;

    if (numsSize == 0 || k <= 0 || k > numsSize)
        return NULL;

    int *result = malloc(numsSize * sizeof(int));
    int *deque = malloc(numsSize * sizeof(int));

    if (!result || !deque) {
        free(result);
        free(deque);
        return NULL;
    }

    int front = 0, rear = 0;
    int count = 0;

    for (int i = 0; i < numsSize; i++) {
      
        while (front < rear && deque[front] <= i - k)
            front++;

        while (front < rear &&
               nums[deque[rear - 1]] <= nums[i])
            rear--;

        deque[rear++] = i;

      
        if (i >= k - 1)
            result[count++] = nums[deque[front]];
    }

    *returnSize = count;
    free(deque);

    return result;
}
