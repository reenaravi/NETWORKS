#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <time.h>

#define SIZE 256
#define LOSSPROB 25

int sfd;
struct sockaddr_in saddr, caddr;
socklen_t clen;
char buf[SIZE];
int expected;

int simloss()
{
    return (rand() % 100) < LOSSPROB;
}

unsigned char calcchk(char *d, int l)
{
    unsigned int sum = 0;
    int i;
    for (i = 0; i < l; i++)
        sum = sum + (unsigned char)d[i];
    return (unsigned char)(~sum & 0xFF);
}

void tobin(unsigned char val, char *out)
{
    int i;
    for (i = 7; i >= 0; i--)
        out[7 - i] = ((val >> i) & 1) ? '1' : '0';
    out[8] = '\0';
}

int main(int argc, char *argv[])
{
    if (argc != 2)
    {
        printf("Usage: %s <port>\n", argv[0]);
        return 1;
    }

    srand(time(NULL));

    printf("=== Stop-and-Wait ARQ Receiver ===\n\n");

    sfd = socket(AF_INET, SOCK_DGRAM, 0);
    if (sfd < 0)
    {
        perror("socket");
        return 1;
    }

    memset(&saddr, 0, sizeof(saddr));
    saddr.sin_family = AF_INET;
    saddr.sin_port = htons(atoi(argv[1]));
    saddr.sin_addr.s_addr = INADDR_ANY;

    if (bind(sfd, (struct sockaddr *)&saddr, sizeof(saddr)) < 0)
    {
        perror("bind");
        close(sfd);
        return 1;
    }

    printf("Waiting for sender on port %s...\n", argv[1]);

    expected = 0;
    int connected = 0;

    while (1)
    {
        clen = sizeof(caddr);
        int n = recvfrom(sfd, buf, SIZE - 1, 0, (struct sockaddr *)&caddr, &clen);
        if (n < 0)
        {
            perror("recvfrom");
            continue;
        }
        buf[n] = '\0';

        if (!connected)
        {
            printf("Sender connected.\n\n");
            connected = 1;
        }

        if (strcmp(buf, "END") == 0)
        {
            printf("\n=== All packets received successfully ===\n");
            break;
        }

        int seq;
        unsigned int rchk;
        char data[SIZE];
        sscanf(buf, "%d|%u|%[^\n]", &seq, &rchk, data);

        unsigned char calc = calcchk(data, strlen(data));
        char rbin[9];
        tobin((unsigned char)rchk, rbin);

        printf("\nFrame %d received [\"%s\"], checksum %s\n", seq, data, rbin);

        if (calc != (unsigned char)rchk)
        {
            printf("Checksum verified: ERROR DETECTED, discarding frame, no ACK sent\n");
            continue;
        }

        printf("Checksum verified: OK\n");

        if (seq == expected)
        {
            int ackval = 1 - seq;
            expected = 1 - expected;
            printf("Sending ACK %d\n", ackval);

            if (simloss())
            {
                printf("ACK %d lost in transit\n", ackval);
            }
            else
            {
                char ack[10];
                sprintf(ack, "%d", ackval);
                sendto(sfd, ack, strlen(ack), 0, (struct sockaddr *)&caddr, clen);
            }
        }
        else
        {
            printf("Duplicate Frame %d, discarding\n", seq);
            int ackval = 1 - seq;
            printf("Resending ACK %d\n", ackval);
            char ack[10];
            sprintf(ack, "%d", ackval);
            sendto(sfd, ack, strlen(ack), 0, (struct sockaddr *)&caddr, clen);
        }
    }

    close(sfd);
    return 0;
}
