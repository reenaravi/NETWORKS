#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <time.h>

#define SIZE 256
#define LOSSPROB 25

struct pkt
{
    char data[SIZE];
    struct pkt *next;
};

struct pkt *head, *tail;
struct pkt *arr[100];
int cnt, seq;
int sfd;
struct sockaddr_in raddr;
socklen_t len;
char buf[SIZE];
int cpkt, cbit;
int sentonce[100];

void addpkt(char *d)
{
    struct pkt *n = (struct pkt *)malloc(sizeof(struct pkt));
    strcpy(n->data, d);
    n->next = NULL;
    if (head == NULL)
        head = n;
    else
        tail->next = n;
    tail = n;
}

unsigned char calcchk(char *d, int l)
{
    unsigned int sum = 0;
    int i;
    for (i = 0; i < l; i++)
        sum = sum + (unsigned char)d[i];
    return (unsigned char)(~sum & 0xFF);
}

void flipbit(char *d, int bit)
{
    int byteidx = bit / 8;
    int bitidx = bit % 8;
    d[byteidx] = d[byteidx] ^ (1 << (7 - bitidx));
}

int simloss()
{
    return (rand() % 100) < LOSSPROB;
}

int main(int argc, char *argv[])
{
    if (argc != 3)
    {
        printf("Usage: %s <receiver_ip> <port>\n", argv[0]);
        return 1;
    }

    srand(time(NULL));

    printf("=== Stop-and-Wait ARQ with Checksum ===\n\n");

    printf("Enter number of packets: ");
    scanf("%d", &cnt);
    getchar();

    int i;
    for (i = 0; i < cnt; i++)
    {
        char temp[SIZE];
        printf("Enter data for packet %d: ", i + 1);
        fgets(temp, SIZE, stdin);
        temp[strcspn(temp, "\n")] = '\0';
        addpkt(temp);
    }

    struct pkt *cur = head;
    for (i = 0; i < cnt; i++)
    {
        arr[i] = cur;
        cur = cur->next;
    }

    cpkt = -1;
    char ans[10];
    printf("\nDo you want to introduce an error in any packet? (y/n): ");
    scanf("%s", ans);
    if (ans[0] == 'y' || ans[0] == 'Y')
    {
        printf("Enter packet number to corrupt (1-%d): ", cnt);
        scanf("%d", &cpkt);
        int dlen = strlen(arr[cpkt - 1]->data);
        printf("Enter bit position to flip (0-%d): ", dlen * 8 - 1);
        scanf("%d", &cbit);
        cpkt = cpkt - 1;
        printf("\nBit %d of Packet %d flipped for transmission.\n", cbit, cpkt + 1);
    }

    sfd = socket(AF_INET, SOCK_DGRAM, 0);
    if (sfd < 0)
    {
        perror("socket");
        return 1;
    }

    memset(&raddr, 0, sizeof(raddr));
    raddr.sin_family = AF_INET;
    raddr.sin_port = htons(atoi(argv[2]));
    inet_pton(AF_INET, argv[1], &raddr.sin_addr);
    len = sizeof(raddr);

    struct timeval tv;
    tv.tv_sec = 2;
    tv.tv_usec = 0;
    setsockopt(sfd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));

    printf("\nConnecting to receiver...\n");
    printf("Starting Stop-and-Wait transmission...\n");

    seq = 0;

    for (i = 0; i < cnt; i++)
    {
        printf("\n--- Sending Packet %d ---\n", i + 1);

        int dlen = strlen(arr[i]->data);
        unsigned char chk = calcchk(arr[i]->data, dlen);

        int acked = 0;
        int firsttry = 1;

        while (!acked)
        {
            char sendata[SIZE];
            strcpy(sendata, arr[i]->data);

            if (i == cpkt && !sentonce[i])
            {
                flipbit(sendata, cbit);
                sentonce[i] = 1;
                printf("Sending Frame %d [\"%s\"], data corrupted (bit %d flipped)\n", seq, arr[i]->data, cbit);
            }
            else if (firsttry)
            {
                printf("Sending Frame %d [\"%s\"]\n", seq, arr[i]->data);
            }
            else
            {
                printf("Sending Frame %d (resent) [\"%s\"]\n", seq, arr[i]->data);
            }

            if (firsttry)
                printf("Timer started\n");

            char frame[SIZE + 20];
            sprintf(frame, "%d|%u|%s", seq, chk, sendata);

            int lost = 0;
            if (i != cpkt && simloss())
            {
                printf("Frame lost in transit\n");
                lost = 1;
            }

            if (!lost)
                sendto(sfd, frame, strlen(frame), 0, (struct sockaddr *)&raddr, len);

            int n = recvfrom(sfd, buf, SIZE - 1, 0, NULL, NULL);
            if (n < 0)
            {
                printf("Timeout! No ACK received. Resending Frame %d\n", seq);
                printf("Timer restarted\n");
                firsttry = 0;
                continue;
            }
            buf[n] = '\0';

            int ackseq = atoi(buf);
            int expected = 1 - seq;
            if (ackseq == expected)
            {
                printf("ACK %d received\n", ackseq);
                printf("Packet %d delivered successfully.\n", i + 1);
                acked = 1;
                seq = 1 - seq;
            }
            else
            {
                printf("Old ACK %d received, ignoring\n", ackseq);
            }
        }
    }

    sendto(sfd, "END", 3, 0, (struct sockaddr *)&raddr, len);

    printf("\n=== All %d packets transmitted successfully ===\n", cnt);

    close(sfd);
    return 0;
}
