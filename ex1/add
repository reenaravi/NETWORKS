char* addBinary(char* a, char* b) {
    int i = strlen(a) - 1;
    int j = strlen(b) - 1;
    int carry = 0;

    int n = strlen(a);
    int m = strlen(b);
    int size = (n > m ? n : m) + 2;

    char* result = malloc(size);

    int k = size - 1;
    result[k] = '\0';
    k--;

    while (i >= 0 || j >= 0 || carry) {
        int sum = carry;

        if (i >= 0)
            sum += a[i--] - '0';

        if (j >= 0)
            sum += b[j--] - '0';

        result[k--] = (sum % 2) + '0';
        carry = sum / 2;
    }

    
    memmove(result, result + k + 1, size - k - 1);

    return result;
}
