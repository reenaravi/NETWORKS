#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#define TOTALHOSTS 4
#define MAXMSG 200
#define MAXBIN 5000
struct Host
{
    char url[30];
    char ip[20];
    char mac[25];
};
struct Frame
{
    char sourceURL[30];
    char destinationURL[30];

    char sourceIP[20];
    char destinationIP[20];

    char sourceMAC[25];
    char destinationMAC[25];

    char message[MAXMSG];

    char binaryMessage[MAXBIN];
    char generator[20];
    char dividend[MAXBIN];
    char remainder[20];
    char codeword[MAXBIN];
};
struct Host hostTable[TOTALHOSTS] =
{
    {"amazon.com","192.168.10.2","10:20:30:40:50:60"},
    {"facebook.com","192.168.10.3","11:22:33:44:55:66"},
    {"youtube.com","192.168.10.4","AA:11:BB:22:CC:33"},
    {"github.com","192.168.10.5","12:34:56:78:9A:BC"}
};

struct Frame frame;
char receivedCodeword[MAXBIN];
char recoveredBinary[MAXBIN];
char recoveredMessage[MAXMSG];
void showHosts();
int findHost(char url[]);
void readInput();

void decimalToBinary(int num, char binary[]);
void convertIP(char ip[]);
void convertMAC(char mac[]);
void convertMessage(char message[]);
void sender();

void appendZero();
void crc();
void packet();
void frameData();

void binaryToText();
void receiver();
int main()
{
    printf("\n==========================================");
    printf("\n      CYCLIC REDUNDANCY CHECK (CRC)");
    printf("\n==========================================\n");

    showHosts();

    readInput();

    sender();

    packet();

    frameData();

    receiver();

    return 0;
}
void showHosts()
{
    int i;

    printf("\nAvailable Host Details\n");
    printf("--------------------------------------------------------------------------\n");
    printf("%-5s %-20s %-18s %-22s\n",
           "No","URL","IP Address","MAC Address");
    printf("--------------------------------------------------------------------------\n");

    for(i=0;i<TOTALHOSTS;i++)
    {
        printf("%-5d %-20s %-18s %-22s\n",
               i+1,
               hostTable[i].url,
               hostTable[i].ip,
               hostTable[i].mac);
    }

    printf("--------------------------------------------------------------------------\n");
}
int findHost(char url[])
{
    int i;

    for(i=0;i<TOTALHOSTS;i++)
    {
        if(strcmp(hostTable[i].url,url)==0)
        {
            return i;
        }
    }

    return -1;
}
void readInput()
{
    int src,dest;

    printf("\nEnter Source URL : ");
    scanf("%s",frame.sourceURL);

    printf("Enter Destination URL : ");
    scanf("%s",frame.destinationURL);

    getchar();

    printf("Enter Message : ");
    fgets(frame.message,sizeof(frame.message),stdin);

    frame.message[strcspn(frame.message,"\n")] = '\0';

    src = findHost(frame.sourceURL);
    dest = findHost(frame.destinationURL);

    if(src==-1 || dest==-1)
    {
        printf("\nInvalid Host Name.\n");
        exit(0);
    }

    strcpy(frame.sourceIP,hostTable[src].ip);
    strcpy(frame.destinationIP,hostTable[dest].ip);

    strcpy(frame.sourceMAC,hostTable[src].mac);
    strcpy(frame.destinationMAC,hostTable[dest].mac);

    strcpy(frame.generator,"1001");
}
void decimalToBinary(int num, char binary[])
{
    int i;

    for(i = 7; i >= 0; i--)
    {
        binary[i] = (num % 2) + '0';
        num = num / 2;
    }

    binary[8] = '\0';
}
void convertIP(char ip[])
{
    char temp[20];
    char *token;
    char binary[9];

    strcpy(temp, ip);

    token = strtok(temp, ".");

    while(token != NULL)
    {
        decimalToBinary(atoi(token), binary);
        printf("%s ", binary);

        token = strtok(NULL, ".");
    }

    printf("\n");
}
void convertMAC(char mac[])
{
    char temp[30];
    char *token;
    char binary[9];
    int value;

    strcpy(temp, mac);

    token = strtok(temp, ":");

    while(token != NULL)
    {
        value = (int)strtol(token, NULL, 16);

        decimalToBinary(value, binary);

        printf("%s ", binary);

        token = strtok(NULL, ":");
    }

    printf("\n");
}
void convertMessage(char message[])
{
    int i;
    char binary[9];

    frame.binaryMessage[0] = '\0';

    for(i = 0; message[i] != '\0'; i++)
    {
        decimalToBinary((unsigned char)message[i], binary);
        strcat(frame.binaryMessage, binary);
    }
}
void sender()
{
    printf("\n==================== SENDER ====================\n");

    printf("\nSource URL        : %s", frame.sourceURL);
    printf("\nDestination URL   : %s", frame.destinationURL);

    printf("\n\nSource IP         : %s", frame.sourceIP);
    printf("\nDestination IP    : %s", frame.destinationIP);

    printf("\n\nSource MAC        : %s", frame.sourceMAC);
    printf("\nDestination MAC   : %s", frame.destinationMAC);

    printf("\n\nOriginal Message  : %s\n", frame.message);

    printf("\n------------------------------------------");
    printf("\nSOURCE IP IN BINARY");
    printf("\n------------------------------------------\n");

    convertIP(frame.sourceIP);

    printf("\n------------------------------------------");
    printf("\nDESTINATION IP IN BINARY");
    printf("\n------------------------------------------\n");

    convertIP(frame.destinationIP);

    printf("\n------------------------------------------");
    printf("\nSOURCE MAC IN BINARY");
    printf("\n------------------------------------------\n");

    convertMAC(frame.sourceMAC);

    printf("\n------------------------------------------");
    printf("\nDESTINATION MAC IN BINARY");
    printf("\n------------------------------------------\n");

    convertMAC(frame.destinationMAC);

    convertMessage(frame.message);

    printf("\n------------------------------------------");
    printf("\nMESSAGE IN BINARY");
    printf("\n------------------------------------------\n");

    printf("%s\n", frame.binaryMessage);
}
void appendZero()
{
    int i;

    strcpy(frame.dividend, frame.binaryMessage);

    for(i = 0; i < strlen(frame.generator) - 1; i++)
    {
        strcat(frame.dividend, "0");
    }
}
void crc()
{
    char temp[MAXBIN];
    int i, j;
    int dataLength, generatorLength;

    strcpy(temp, frame.dividend);

    dataLength = strlen(temp);
    generatorLength = strlen(frame.generator);

    for(i = 0; i <= dataLength - generatorLength; i++)
    {
        if(temp[i] == '1')
        {
            for(j = 0; j < generatorLength; j++)
            {
                if(temp[i + j] == frame.generator[j])
                    temp[i + j] = '0';
                else
                    temp[i + j] = '1';
            }
        }
    }

    for(i = 0; i < generatorLength - 1; i++)
    {
        frame.remainder[i] =
            temp[dataLength - generatorLength + 1 + i];
    }

    frame.remainder[generatorLength - 1] = '\0';

    strcpy(frame.codeword, frame.binaryMessage);
    strcat(frame.codeword, frame.remainder);
}
void packet()
{
    appendZero();

    crc();

    printf("\n==================== PACKET ====================\n");

    printf("\nGenerator Polynomial : %s", frame.generator);

    printf("\n\nDividend");
    printf("\n%s", frame.dividend);

    printf("\n\nCRC Remainder");
    printf("\n%s", frame.remainder);

    printf("\n\nPacket(Codeword)");
    printf("\n%s\n", frame.codeword);
}
void frameData()
{
    printf("\n===================== FRAME ====================\n");

    printf("\nSource URL        : %s", frame.sourceURL);
    printf("\nDestination URL   : %s", frame.destinationURL);

    printf("\n\nSource IP         : %s", frame.sourceIP);
    printf("\nDestination IP    : %s", frame.destinationIP);

    printf("\n\nSource MAC        : %s", frame.sourceMAC);
    printf("\nDestination MAC   : %s", frame.destinationMAC);

    printf("\n\nFrame Payload");
    printf("\n%s\n", frame.codeword);

    strcpy(receivedCodeword, frame.codeword);

void binaryToText()
{
    int i, j;
    int value;
    char bits[9];

    recoveredMessage[0] = '\0';

    for(i = 0; i < strlen(recoveredBinary); i += 8)
    {
        strncpy(bits, recoveredBinary + i, 8);
        bits[8] = '\0';

        value = 0;

        for(j = 0; j < 8; j++)
        {
            value = value * 2 + (bits[j] - '0');
        }

        recoveredMessage[strlen(recoveredMessage)] = (char)value;
        recoveredMessage[strlen(recoveredMessage) + 1] = '\0';
    }
}
void receiver()
{
    char temp[MAXBIN];
    int i, j;
    int dataLength, generatorLength;
    int error = 0;

    strcpy(temp, receivedCodeword);

    dataLength = strlen(temp);
    generatorLength = strlen(frame.generator);

    for(i = 0; i <= dataLength - generatorLength; i++)
    {
        if(temp[i] == '1')
        {
            for(j = 0; j < generatorLength; j++)
            {
                if(temp[i + j] == frame.generator[j])
                    temp[i + j] = '0';
                else
                    temp[i + j] = '1';
            }
        }
    }

    printf("\n==================== RECEIVER ====================\n");

    printf("\nReceived Codeword");
    printf("\n%s\n", receivedCodeword);

    printf("\nCRC Remainder : ");

    for(i = dataLength - generatorLength + 1; i < dataLength; i++)
    {
        printf("%c", temp[i]);

        if(temp[i] != '0')
        {
            error = 1;
        }
    }

    if(error == 0)
    {
        printf("\n\nStatus : No Error Detected\n");
    }
    else
    {
        printf("\n\nStatus : Error Detected\n");
    }

    strncpy(recoveredBinary,
            receivedCodeword,
            dataLength - (generatorLength - 1));

    recoveredBinary[dataLength - (generatorLength - 1)] = '\0';

    printf("\nRecovered Binary");
    printf("\n%s\n", recoveredBinary);

    binaryToText();

    printf("\nRecovered Message");
    printf("\n%s\n", recoveredMessage);

    printf("\n===============================================\n");
}
